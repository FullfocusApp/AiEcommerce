{
  "name": "ai-ecommerce-os",
  "version": "1.0.0",
  "description": "Autonomous AI system for e-commerce operations",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "service:shopify": "node services/shopify-integration/index.js",
    "service:ai-content": "node services/ai-content-engine/index.js",
    "service:pricing": "node services/pricing-engine/index.js",
    "service:marketing": "node services/marketing-automation/index.js",
    "service:customer": "node services/customer-intelligence/index.js",
    "service:support": "node services/support-bot/index.js",
    "service:dashboard": "node services/analytics-dashboard/index.js",
    "dev:all": "concurrently \"npm run service:shopify\" \"npm run service:ai-content\" \"npm run service:pricing\" \"npm run service:marketing\" \"npm run service:customer\" \"npm run service:support\" \"npm run service:dashboard\"",
    "db:init": "node shared/database/init.js",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": [
    "ai",
    "ecommerce",
    "automation",
    "shopify",
    "marketing"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@shopify/shopify-api": "^9.0.0",
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "openai": "^4.20.0",
    "@anthropic-ai/sdk": "^0.10.0",
    "mongoose": "^8.0.0",
    "redis": "^4.6.0",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.0",
    "winston": "^3.11.0",
    "node-cron": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "eslint": "^8.54.0"
  }
}
