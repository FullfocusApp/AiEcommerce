# Shopify Configuration
SHOPIFY_STORE_URL=fullfocustrends.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_access_token_here
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_ADMIN_API_VERSION=2024-01

# AI Services
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Database
MONGODB_URI=mongodb://localhost:27017/aiecommerce
REDIS_URL=redis://localhost:6379

# Marketing Integrations
META_ACCESS_TOKEN=your_meta_token_here
META_AD_ACCOUNT_ID=your_ad_account_id
GOOGLE_ADS_CLIENT_ID=your_google_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_google_client_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_token_here
KLAVIYO_API_KEY=your_klaviyo_key_here

# n8n Automation
N8N_WEBHOOK_URL=your_n8n_instance_url_here

# Server Configuration
PORT=3000
NODE_ENV=development
API_VERSION=v1

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Feature Flags
ENABLE_DYNAMIC_PRICING=true
ENABLE_AI_CONTENT=true
ENABLE_AUTO_POSTING=false
ENABLE_SUPPORT_BOT=true

# Pricing Engine Settings
MIN_PRICE_MULTIPLIER=0.8
MAX_PRICE_MULTIPLIER=1.5
PRICE_UPDATE_FREQUENCY=3600000

# Content Generation Settings
CONTENT_GENERATION_MODEL=gpt-4
MAX_DAILY_POSTS=10
CONTENT_REVIEW_MODE=auto

# Support Bot Settings
SUPPORT_BOT_LANGUAGE=en
SUPPORT_ESCALATION_THRESHOLD=0.7
